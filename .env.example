# ------------------------------------------------------------------
# Zora environment variables — copy this file to `.env` and fill in.
#   cp .env.example .env
# ------------------------------------------------------------------

# ---- Auth (NextAuth v5 / Auth.js) ----
# Generate a strong secret:  openssl rand -base64 32
AUTH_SECRET=

# Set to your site URL in production (not needed for local dev).
# AUTH_URL=https://your-domain.com

# ---- Google OAuth (Sign in / Sign up with Google) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (local):  http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- First admin account (used by `npm run seed:admin`) ----
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Database (Neon Postgres) ----
# Server-only (no NEXT_PUBLIC_ prefix, so it never reaches the browser).
DB_CONNECTION_STRING=

# ---- Groq (AI course & quiz generation) ----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the default model (llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# ---- Cloudinary (profile pictures & custom course banners, server-only) ----
# Dashboard → account details: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Firebase (optional, used by some features) ----
NEXT_PUBLIC_FIREBASE_API_KEY=

# ---- YouTube Data API (course videos, server-only) ----
YOUTUBE_API_KEY=

# ---- Misc ----
# Base URL / host used by some client calls.
NEXT_PUBLIC_HOST_NAME=http://localhost:3000
# External Flask model for the /api/bhutan endpoint.
API_URL=http://127.0.0.1:5000
